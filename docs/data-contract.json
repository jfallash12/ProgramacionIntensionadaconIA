        },
        {
          "id": "act-002",
          "date": "2026-10-11",
          "time": "15:30",
          "title": "Termales Tabacón",
          "categoryId": "cat-actividades",
          "estimatedCost": 52,
          "status": "en_progreso"
        },
        {
          "id": "act-003",
          "date": "2026-10-11",
          "time": "19:30",
          "title": "Cena Mirador",
          "categoryId": "cat-comida",
          "status": "pendiente"
        }
      ]
    }
  ]
}
